{
  "name": "sage",
  "version": "1.0.0",
  "description": "Sage — an iMessage agent that checks if a text, email, job offer or forward is legit, using Photon Spectrum + TinyFish.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "terminal": "SAGE_MODE=terminal bun run src/index.ts",
    "check": "bun run scripts/check.ts",
    "smoke": "bun run scripts/smoke.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "@tiny-fish/sdk": "^0.8.0",
    "spectrum-ts": "^12.10.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
