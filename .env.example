# Photon Spectrum — app.photon.codes → your project → Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# TinyFish — agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Gemini (free tier) — aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite

# Optional
SAGE_NAME=Sage
# imessage (default) or terminal (test in your terminal, no phone needed)
SAGE_MODE=imessage
# Demo mode: only these numbers get replies (comma-separated, E.164). Leave empty for anyone.
ALLOWLIST=
CHECKS_PER_USER_PER_DAY=8
AGENT_RUNS_PER_DAY=40
# After "I already clicked", Sage checks in once this many minutes later (1 for a demo)
CHECKIN_MINUTES=60
